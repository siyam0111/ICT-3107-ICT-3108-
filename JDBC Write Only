import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class WriteOnlyJDBCExample {
    public static void main(String[] args) {
        // Database connection details
        String url = "jdbc:mysql://localhost:3306/testdb"; // Replace with your DB name
        String user = "root"; // Replace with your DB username
        String password = "password"; // Replace with your DB password

        Connection conn = null;
        PreparedStatement pstmt = null;

        try {
            // Step 1: Load JDBC driver (optional for newer versions)
            Class.forName("com.mysql.cj.jdbc.Driver");

            // Step 2: Establish connection
            conn = DriverManager.getConnection(url, user, password);

            // Step 3: Create SQL INSERT statement
            String sql = "INSERT INTO students (id, name, grade) VALUES (?, ?, ?)";
            pstmt = conn.prepareStatement(sql);

            // Step 4: Set values
            pstmt.setInt(1, 1);
            pstmt.setString(2, "Siyam");
            pstmt.setString(3, "A");

            // Step 5: Execute update (write-only)
            int rowsInserted = pstmt.executeUpdate();
            System.out.println(rowsInserted + " row(s) inserted successfully.");

        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            // Step 6: Close resources
            try {
                if (pstmt != null) pstmt.close();
                if (conn != null) conn.close();
            } catch (SQLException se) {
                se.printStackTrace();
            }
        }
    }
}
